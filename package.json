{
  "name": "kennice-tours-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --disable-source-maps",
    "dev:clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next dev --disable-source-maps",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:turbo": "next dev --turbo --disable-source-maps"
  },
  "dependencies": {
    "next": "^15.2.8",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "jsdom": "^30.1.0",
    "typescript": "5.8.2",
    "vitest": "^5.0.1"
  }
}
